@page "/my-courses"

<PageTitle>Мои курсы</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    
    <MudTabs Outlined="true" Position="Position.Left" Rounded="true" Border="true"
             ApplyEffectsToContainer="true" Class="mt-8" PanelClass="pa-6"
             @bind-ActivePanelIndex="_activeIndex">
        <MudTabPanel Text="Платные">
            <MudText>Content One</MudText>
        </MudTabPanel>
        <MudTabPanel Text="Бесплатные">
            <MudText>Content Two</MudText>
        </MudTabPanel>
    </MudTabs>
    
    <MudText>@($"Active Index: {_activeIndex}")</MudText>
    
</MudContainer>

@code {
    int _activeIndex;
}