@inject HttpClient HttpClient
@inject IBrowserViewportService BrowserViewportService
@using ApiEndpoints
@using ContractualDtos.DTO.Course.CourseTheme.Dtos
@inject NavigationManager NavManager
@page "/courses"

<PageTitle>Темы</PageTitle>

<MudContainer Class="mt-16">
    <MudGrid Class="mt-8">
        @if (_coursers != null)
        {
            @foreach (var course in _coursers)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="25" Class="rounded-lg pb-4">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: bold;">@course.Name</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <div class="d-flex justify-center pb-3">
                                @*TODO:сделать изменение через признак из бд*@
                                <MudText Typo="Typo.h3">@(course.IsFree ? "Бесплатно" : "100$")</MudText>
                            </div>
                            <MudList T="string" Class="mx-auto mt-4" Style="width:300px;">
                                @if (course.CourseThemeRecommendation.Any())
                                {
                                    @foreach (var themeRecommendation in course.CourseThemeRecommendation)
                                    {
                                        <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                            @themeRecommendation.Name
                                        </MudListItem>
                                    }
                                }
                                else
                                {
                                    <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                        1
                                    </MudListItem>
                                    <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                        2
                                    </MudListItem>
                                    <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                        3
                                    </MudListItem>
                                }
                            </MudList>
                        </MudCardContent>
                        <MudCardActions Class="d-flex justify-center">
                            @*TODO:сделать изменение через признак с БД*@
                            <MudButton @onclick="@(_ => NavToTaskSelectPage(course.Id))" Variant="Variant.Filled"
                                       Color="Color.Primary" Size="Size.Large"
                                       Style="width:50%;">
                                @(course.IsFree ? "Изучить" : "Подробнее")
                            </MudButton>
                        </MudCardActions>
                        @if (course.IsFree)
                        {
                            <MudCardContent Style="padding-bottom: 0;">
                                <div class="d-flex justify-center">
                                    <MudText Typo="Typo.caption" Align="Align.Justify">
                                        * курс может включать в себя платный доп. контент
                                    </MudText>
                                </div>
                            </MudCardContent>
                        }
                        else
                        {
                            <MudCardContent Style="padding-bottom: 0;">
                                <div class="d-flex justify-center">
                                    <MudText Typo="Typo.caption" Align="Align.Justify">
                                        * доступ предоставляется навсегда
                                    </MudText>
                                </div>
                            </MudCardContent>
                        }
                    </MudCard>
                </MudItem>
            }
        }
        else
        {
            @for (var i = SkeletonCnt; i < _skeletonCntMax; i++)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="25" Class="rounded-lg pb-4">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudSkeleton Animation="Animation.Wave" />
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <div class="d-flex justify-center">
                                <MudSkeleton Animation="Animation.Wave" Style="width: 250px; height: 56px;"/>
                            </div>
                            <MudList T="string" Class="mx-auto mt-4" Style="width:300px;">
                                <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                    <MudSkeleton Animation="Animation.Wave" />
                                </MudListItem>
                                <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                    <MudSkeleton Animation="Animation.Wave" />
                                </MudListItem>
                                <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                    <MudSkeleton Animation="Animation.Wave" />
                                </MudListItem>
                            </MudList>
                        </MudCardContent>
                        <MudCardActions Class="d-flex justify-center">
                            <MudSkeleton  Style="width:50%;" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }
    </MudGrid>
</MudContainer>

@code{

    /// <summary>
    /// Темы курсов из БД
    /// </summary>
    private DetailedCourseThemeDtos[]? _coursers;

    private Breakpoint _currentBreakpoint;
    private const int SkeletonCnt = 0;
    private int _skeletonCntMax;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        // Подписываемся на изменения размера окна
        await BrowserViewportService.SubscribeAsync(Guid.NewGuid(), OnViewportChanged, fireImmediately: true);

        _coursers = await HttpClient.GetFromJsonAsync<DetailedCourseThemeDtos[]?>
            (ApiEndpointRoutes.CourseThemes.FilteredGetAll);
        
        if (_coursers != null)
        {
            await BrowserViewportService.UnsubscribeAsync(Guid.NewGuid());
        }
    }
    
    /// <summary>
    /// Событие на изменение точки ширины окна
    /// </summary>
    /// <param name="args">Размер окна (Xs, Sm, Md)</param>
    private async Task OnViewportChanged(BrowserViewportEventArgs args)
    {
        if (_coursers != null) return;
            
        _currentBreakpoint = args.Breakpoint;
        /*TODO: Удалить на release версии*/
        Console.WriteLine($"Размер экрана - {_currentBreakpoint}");

        switch (_currentBreakpoint)
        {
            case (Breakpoint.Xxl):
                _skeletonCntMax = 9;
                break;
            case (Breakpoint.Xl):
            case (Breakpoint.Lg):
            case (Breakpoint.Md):
                _skeletonCntMax = 6;
                break;
            case (Breakpoint.Sm):
                _skeletonCntMax = 4;
                break;
            case (Breakpoint.Xs):
                _skeletonCntMax = 2;
                break;
            default:
                _skeletonCntMax = 6;
                break;
        }

        await InvokeAsync(StateHasChanged);
    }
    
    private void NavToTaskSelectPage(Guid themeId)
    {
        NavManager.NavigateTo($"/course/{themeId}");
    }
}
