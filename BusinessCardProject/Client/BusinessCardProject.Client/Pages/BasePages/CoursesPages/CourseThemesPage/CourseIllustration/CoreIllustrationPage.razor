@using ApiEndpoints
@inject HttpClient HttpClient
@using ContractualDtos.DTO.Course.CourseTheme.Dtos
@page "/course/{id:guid}"

<PageTitle>
    @(_course != null ? $"Курс - {_course.Name}" : "Курс")
</PageTitle>

<MudContainer Class="py-4 py-sm-8 py-md-12 py-lg-16 py-xl-20">
    <MudGrid>
        @if (_course != null)
        {
            <MudItem xs="12">
                <MudImage ObjectFit="ObjectFit.Cover" Src="images/logoCourse.jpg" Alt="Breaking Bed"
                          Class="rounded-lg" Height="256" Style="width: 100%"/>
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex flex-column align-center">
                <MudAvatar Class="mb-2" Color="Color.Default" Variant="Variant.Filled" Size="Size.Large">
                    <MudIcon Color="Color.Dark" Icon="@Icons.Material.Rounded.Person" Size="Size.Large"/>
                </MudAvatar>
                <MudText Typo="Typo.h5" Class="mb-2">Никита С.</MudText>
                <MudSkeleton Animation="Animation.False" SkeletonType="SkeletonType.Rectangle" Height="4px" Width="20%"
                             Class="mb-4" Style="background-color: var(--mud-palette-primary);"/>
                <MudText Align="Align.Center" Typo="Typo.body2">
                    Бла-бла, описание, да-да
                </MudText>
            </MudItem>
            <MudItem xs="12" md="9">
                <MudText Typo="Typo.h6" HtmlTag="p" Align="Align.Justify">
                    @_course.Description
                </MudText>
            </MudItem>
            
            <MudItem xs="12" Class="mt-6">
                <MudText Typo="Typo.h4" HtmlTag="p" Color="Color.Primary" Style="font-weight: bold;" Class="mb-2">
                    Содержание курса:
                </MudText>
                <MudTreeView T="string" Hover="true" ExpandOnClick="true">
                    @foreach (var module in _course.CourseModules)
                    {
                        <MudTreeViewItem Text="@module.Name" TextTypo="Typo.h4" Class="mb-1">
                            @if (module.VideoCourses.Any())
                            {
                                @foreach (var (videoCourse, index) in module.VideoCourses.Select((v, i) => (v, i)))
                                {
                                    <MudTreeViewItem Text="@($"Урок {index + 1}. {videoCourse.Name}")"
                                                     TextTypo="Typo.h5" Class="mt-1 mb-1">
                                        <MudGrid Class="pt-4 pb-4 pr-7">
                                            <MudItem xs="12" md="3">
                                                <MudImage Src="images/sweden.jpg"
                                                          Alt="Swedish Farm House"
                                                          Style="width: 100%"
                                                          Elevation="25" Class="rounded-lg"/>
                                            </MudItem>
                                            <MudItem xs="12" md="9" Class="d-flex flex-column justify-start">
                                                <MudText Typo="Typo.body1" Class="pb-2">
                                                    @videoCourse.Description
                                                </MudText>
                                            </MudItem>
                                            @*TODO: возможно надо сделать: pt-3*@
                                            <MudItem xs="12" md="3" Class="pt-2 d-flex align-center">
                                                <MudButton Class="mt-2" Style="width: 100%;" Color="Color.Primary"
                                                           Variant="Variant.Filled">
                                                    Смотреть
                                                </MudButton>
                                                <MudIconButton Class="mt-2 ml-1"
                                                               Icon="@Icons.Material.Rounded.Favorite"
                                                               Color="Color.Secondary"
                                                               aria-label="add to favorite"/>
                                            </MudItem>
                                        </MudGrid>
                                    </MudTreeViewItem>
                                }
                            }
                            else
                            {
                                <MudTreeViewItem Text="В разработке!" Disabled="true"/>
                            }
                        </MudTreeViewItem>
                    }
                </MudTreeView>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>
    /// Тем курсов из БД
    /// </summary>
    private DetailedCourseThemeDtos? _course;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _course = await HttpClient.GetFromJsonAsync<DetailedCourseThemeDtos?>
            ($"{ApiEndpointRoutes.CourseThemes.GetById}{Id}");
    }

}