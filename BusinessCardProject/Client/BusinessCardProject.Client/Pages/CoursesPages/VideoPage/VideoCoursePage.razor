<MudContainer Class="mt-16">
    <MudGrid Class="mt-8">
        @if (_coursers != null)
        {
            @foreach (var course in _coursers)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="25" Class="rounded-lg pb-4">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: bold;">@course.Name</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <div class="d-flex justify-center pb-3">
                                @*TODO:сделать изменение через признак из бд*@
                                <MudText Typo="Typo.h3">@(course.IsFree ? "Бесплатно" : "100$")</MudText>
                            </div>
                            <MudList T="string" Class="mx-auto mt-4" Style="width:300px;">
                                <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                    Изучение: @course.ProgrammingLanguage.Name
                                </MudListItem>
                                <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                    2
                                </MudListItem>
                                <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                    3
                                </MudListItem>
                            </MudList>
                        </MudCardContent>
                        <MudCardActions Class="d-flex justify-center">
                            @*TODO:сделать изменение через признак с БД*@
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                       Style="width:50%;">
                                Изучить
                            </MudButton>
                        </MudCardActions>
                        @if (course.IsFree)
                        {
                            <MudCardContent Style="padding-bottom: 0;">
                                <div class="d-flex justify-center">
                                    <MudText Typo="Typo.caption" Align="Align.Justify">
                                        * курс может включать в себя платный доп. контент
                                    </MudText>
                                </div>
                            </MudCardContent>
                        }
                    </MudCard>
                </MudItem>
            }
        }
        else
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="25" Class="rounded-lg pb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudSkeleton Animation="Animation.Wave" />
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <div class="d-flex justify-center">
                            <MudSkeleton Animation="Animation.Wave" Style="width: 250px; height: 56px;"/>
                        </div>
                        <MudList T="string" Class="mx-auto mt-4" Style="width:300px;">
                            <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                <MudSkeleton Animation="Animation.Wave" />
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                <MudSkeleton Animation="Animation.Wave" />
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                <MudSkeleton Animation="Animation.Wave" />
                            </MudListItem>
                        </MudList>
                    </MudCardContent>
                    <MudCardActions Class="d-flex justify-center">
                        <MudSkeleton  Style="width:50%;" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="25" Class="rounded-lg pb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudSkeleton Animation="Animation.Wave" />
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <div class="d-flex justify-center">
                            <MudSkeleton Animation="Animation.Wave" Style="width: 250px; height: 56px;"/>
                        </div>
                        <MudList T="string" Class="mx-auto mt-4" Style="width:300px;">
                            <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                <MudSkeleton Animation="Animation.Wave" />
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                <MudSkeleton Animation="Animation.Wave" />
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                <MudSkeleton Animation="Animation.Wave" />
                            </MudListItem>
                        </MudList>
                    </MudCardContent>
                    <MudCardActions Class="d-flex justify-center">
                        <MudSkeleton  Style="width:50%;" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="25" Class="rounded-lg pb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudSkeleton Animation="Animation.Wave" />
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <div class="d-flex justify-center">
                            <MudSkeleton Animation="Animation.Wave" Style="width: 250px; height: 56px;"/>
                        </div>
                        <MudList T="string" Class="mx-auto mt-4" Style="width:300px;">
                            <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                <MudSkeleton Animation="Animation.Wave" />
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                <MudSkeleton Animation="Animation.Wave" />
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">
                                <MudSkeleton Animation="Animation.Wave" />
                            </MudListItem>
                        </MudList>
                    </MudCardContent>
                    <MudCardActions Class="d-flex justify-center">
                        <MudSkeleton  Style="width:50%;" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code{

    /// <summary>
    /// Темы курсов из БД
    /// </summary>
    private CourseThemeDtos[]? _coursers;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _coursers = await HttpClient.GetFromJsonAsync<CourseThemeDtos[]?>
            ($"{ApiEndpointRoutes.BaseUrl}{ApiEndpointRoutes.CourseThemes.GetAll}");
    }
}
