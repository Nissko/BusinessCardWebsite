@using ApiEndpoints
@using ContractualDtos.DTO.User.UserProfile.Dtos
@using System.Threading
@using ContractualDtos.DTO.Table
@inject HttpClient HttpClient

<MudPaper>
    <MudTable ServerData="ServerReload" Dense="true" Hover="true" Loading="@_isLoading" @ref="_table">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Список пользователей</MudText>
            <MudSpacer/>
            <MudTextField T="string" ValueChanged="@(OnSearch)"
                          Placeholder="Поиск"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Rounded.Search"
                          IconSize="Size.Small"
                          Class="mt-0"/>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel SortLabel="surname" InitialDirection="SortDirection.Ascending" T="UserProfileDtos">
                    ФИО
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortLabel="altname" T="UserProfileDtos">Ник</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortLabel="email" T="UserProfileDtos">Почта</MudTableSortLabel>
            </MudTh>
            <MudTh>Роли</MudTh>
            <MudTh>
                <MudTableSortLabel SortLabel="createdon" T="UserProfileDtos">
                    Дата регистрации
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortLabel="isactive" T="UserProfileDtos">
                    Активен
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortLabel="isblocked" T="UserProfileDtos">
                    Блок
                </MudTableSortLabel>
            </MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ФИО">
                <MudText Typo="Typo.body2">
                    @context.Surname @context.Name @context.Patronymic
                </MudText>
            </MudTd>
            <MudTd DataLabel="Ник">
                <MudText Typo="Typo.body2">
                    @context.AltName
                </MudText>
            </MudTd>
            <MudTd DataLabel="Почта">
                <MudText Typo="Typo.body2">
                    @context.Email
                </MudText>
            </MudTd>
            <MudTd DataLabel="Роли">
                <MudText Typo="Typo.body2">
                    @string.Join(", ", context.UserRoles.Select(t => t.RoleName))
                </MudText>
            </MudTd>
            <MudTd DataLabel="Дата регистрации">
                <MudText Typo="Typo.body2">
                    @context.CreatedOn
                </MudText>
            </MudTd>
            <MudTd DataLabel="Активен">
                <MudText Align="Align.Center" Typo="Typo.body2">
                    @(context.IsActive ? "Да" : "Нет")
                </MudText>
            </MudTd>
            <MudTd DataLabel="Блок">
                <MudText Align="Align.Center" Typo="Typo.body2">
                    @(context.IsBlocked ? "Да" : "Нет")
                </MudText>
            </MudTd>
            <MudTd>
                <MudButton Style="width: 100%; margin-bottom: 5px;" Size="Size.Small" Color="Color.Primary"
                           Variant="Variant.Filled">
                    Изменить
                </MudButton>
                <MudButton Style="width: 100%; margin-bottom: 5px;" Size="Size.Small" Color="Color.Error"
                           Variant="Variant.Filled">
                    Удалить
                </MudButton>
                @if (context.IsBlocked)
                {
                    <MudButton Style="width: 100%;" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                        Разблокировать
                    </MudButton> 
                }
                else
                {
                    <MudButton Style="width: 100%;" Color="Color.Tertiary" Size="Size.Small" Variant="Variant.Filled">
                        Заблокировать
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Пользователи не найдены</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Загрузка...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="[5, 10, 25, 50]"
                           RowsPerPageString="Записей на странице:"/>
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private MudTable<UserProfileDtos>? _table;
    private bool _isLoading = true;
    private string _searchString = "";

    private async Task<TableData<UserProfileDtos>> ServerReload(TableState state, CancellationToken token)
    {
        _isLoading = true;

        try
        {
            // Параметры запроса
            var queryParams = new Dictionary<string, string>
            {
                { "page", (state.Page + 1).ToString() },
                { "pageSize", state.PageSize.ToString() },
                { "search", _searchString },
                { "sortBy", state.SortLabel ?? "" },
                { "sortDirection", state.SortDirection.ToString() }
            };

            var url = $"{ApiEndpointRoutes.Users.GetAll}?{string.Join("&", queryParams.Select(kvp => $"{kvp.Key}={Uri.EscapeDataString(kvp.Value)}"))}";
            var response = await HttpClient.GetFromJsonAsync<TableResponse<UserProfileDtos>>(url, token);

            return new TableData<UserProfileDtos>
            {
                TotalItems = response?.TotalCount ?? 0,
                Items = response?.Items ?? []
            };
        }
        catch
        {
            return new TableData<UserProfileDtos> { TotalItems = 0, Items = new List<UserProfileDtos>() };
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnSearch(string text)
    {
        _searchString = text;
        _table?.ReloadServerData();
    }

}