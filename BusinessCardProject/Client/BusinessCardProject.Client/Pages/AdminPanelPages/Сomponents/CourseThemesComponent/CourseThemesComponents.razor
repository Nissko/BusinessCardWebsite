@*@using ApiEndpoints
@using BusinessCardProject.Client.Pages.AdminPanelPages.Сomponents.CourseThemesComponent.Components
@using BusinessCardProject.Client.Pages.AdminPanelPages.Сomponents.CourseThemesComponent.Components.ComponentItems
@using ContractualDtos.DTO.Course.CourseTheme.Dtos
@inject HttpClient HttpClient
@using ContractualDtos.DTO.Course.ProgrammingLanguageCourse.Dtos

$1$

    - Добавить поддержку изменения свойств (displayOrder, isVisible, isShow)
    - Выбор темы курса через Select(-ы), а не через MudTabPanel, с возможностью выбора языка, либо же поиск из всех
    - Сделать добавление модулей отсюда, также добавление видеоуроков
    - При добавлении нового курса, он автоматически становится выбранным (isVisible = False)
#1#

<MudContainer>
    <MudGrid>
        <MudItem Style="padding-left: 6px !important;" xs="12" md="12" Class="d-flex">
            <MudAutocomplete T="string" Label="Язык программирования" @bind-Value="_selectedPl"
                             SearchFunc="SearchFromPl"
                             ResetValueOnEmptyText="true"
                             AdornmentIcon="@Icons.Material.Rounded.Search" AdornmentColor="Color.Primary"
                             Class="px-1"/>

            <MudAutocomplete T="string" Label="Тема" @bind-Value="_selectedCt"
                             @bind-Value:after="UpdateSelectedCtId"
                             SearchFunc="SearchFromCt"
                             ResetValueOnEmptyText="true"
                             AdornmentIcon="@Icons.Material.Rounded.Search" AdornmentColor="Color.Primary"
                             Class="px-1"/>
        </MudItem>
        <MudItem Style="padding-left: 6px !important;" xs="12" md="12" Class="d-flex">
            <PreviewComponent CourseTheme="_courseThemes" SelectedCt="@_selectedCt"
                              OnCourseModuleSelected="@HandleModuleItemSelected"
                              OnVideoCourseSelected="@HandleVideoCourseItemSelected"/>

            <MudTabs Outlined="true" Position="Position.Top" Rounded="true" Border="true"
                     ApplyEffectsToContainer="true" PanelClass="pa-6"
                     @bind-ActivePanelIndex="_activeIndex"
                     Style="width: 50%" Class="px-2 py-2"
                     Elevation="1">

                <MudTabPanel Text="Основная">
                    <CourseThemeTreeItemComponent CourseTheme="_courseThemes"
                                                  SelectedCt="@_selectedCt"
                                                  OnDataChanged="RefreshDataAsync"/>
                </MudTabPanel>

                <MudTabPanel Text="Модули">
                    @if ((_selectedModulePreviewId == Guid.Empty || _selectedModulePreviewId == null) && 
                         !string.IsNullOrEmpty(_selectedCt))
                    {
                        <MudItem Class="d-flex align-center">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Add"/>
                            Добавить
                        </MudItem>
                    }

                    <CourseModuleTreeItemComponent
                        CourseModules="_courseThemes?.FirstOrDefault(cm => cm.Id == _selectedCtId)?.CourseModules.ToList()"
                        SelectedPreviewCourseModuleId="_selectedModulePreviewId"
                        OnDataChanged="RefreshDataAsync"/>
                </MudTabPanel>

                <MudTabPanel Text="Видео">
                    @if (_selectedModulePreviewId != Guid.Empty && _selectedModulePreviewId != null &&
                         (_selectedVideoCoursePreviewId == Guid.Empty || _selectedVideoCoursePreviewId == null) &&
                         !string.IsNullOrEmpty(_selectedCt))
                    {
                        <MudItem Class="d-flex align-center">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Add"/>
                            Добавить
                        </MudItem>
                    }

                    <CourseVideoTreeItemComponent
                        VideoCourses="_courseThemes?.FirstOrDefault(cm => cm.Id == _selectedCtId)?.CourseModules.FirstOrDefault(vc => vc.Id == _selectedModulePreviewId)?.VideoCourses.ToList()"
                        SelectedPreviewCourseModuleId="_selectedVideoCoursePreviewId"
                        OnDataChanged="RefreshDataAsync"/>
                </MudTabPanel>
            </MudTabs>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {

    /// <summary>
    /// TODO:ТЕСТ - УДАЛИТЬ
    /// </summary>
    private int _activeIndex;

    /// <summary>
    /// Выбранный язык программирования
    /// </summary>
    private string? _selectedPl;

    /// <summary>
    /// Выбранная тема
    /// </summary>
    private string? _selectedCt;

    private Guid _selectedCtId;

    /// <summary>
    /// Раскрытый Module Select
    /// </summary>
    private Guid? _selectedModulePreviewId;

    /// <summary>
    /// Раскрытый VideoCourse Select
    /// </summary>
    private Guid? _selectedVideoCoursePreviewId;

    /// <summary>
    /// ЯП с сервера
    /// </summary>
    private List<ProgrammingLanguageDtos>? _programmingLanguage;

    /// <summary>
    /// Темы курсов с сервера
    /// </summary>
    private List<DetailedCourseThemeDtos>? _courseThemes;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _programmingLanguage = await HttpClient.GetFromJsonAsync<List<ProgrammingLanguageDtos>>
            ($"{ApiEndpointRoutes.ProgrammingLanguage.GetAll}");
        _courseThemes = await HttpClient.GetFromJsonAsync<List<DetailedCourseThemeDtos>>
            ($"{ApiEndpointRoutes.CourseThemes.AdminGetAll}");
    }

    /// <summary>
    /// Поиск ЯП
    /// </summary>
    private Task<IEnumerable<string>> SearchFromPl(string? value, CancellationToken token)
    {
        if (!string.IsNullOrEmpty(_selectedCt))
        {
            _selectedCt = string.Empty;
        }

        return _programmingLanguage == null
            ? Task.FromResult<IEnumerable<string>>([])
            : Task.FromResult(string.IsNullOrEmpty(value)
                ? _programmingLanguage.Select(x => x.Name)
                : _programmingLanguage.Select(x => x.Name)
                    .Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)));
    }

    /// <summary>
    /// Поиск тем курсов
    /// </summary>
    private Task<IEnumerable<string>> SearchFromCt(string? value, CancellationToken token)
    {
        if (_courseThemes == null) return Task.FromResult<IEnumerable<string>>([]);

        if (!string.IsNullOrEmpty(_selectedPl))
        {
            var filteredCt = _courseThemes.Where(x => x.ProgrammingLanguage.Name == _selectedPl);
            return Task.FromResult(string.IsNullOrEmpty(value)
                ? filteredCt.Select(x => x.Name)
                : filteredCt.Select(x => x.Name)
                    .Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)));
        }

        return Task.FromResult(string.IsNullOrEmpty(value)
            ? _courseThemes.Select(x => x.Name)
            : _courseThemes.Select(x => x.Name)
                .Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)));
    }

    // Установка значения свойству - _selectedCtId
    private void UpdateSelectedCtId()
    {
        if (_courseThemes != null && !string.IsNullOrEmpty(_selectedCt))
        {
            var selected = _courseThemes.FirstOrDefault(x => x.Name == _selectedCt);
            if (selected != null)
            {
                _selectedCtId = selected.Id;
            }
        }
        else if (string.IsNullOrEmpty(_selectedCt))
        {
            _selectedCtId = Guid.Empty;
        }
    }

    // Обновление данных после изменения
    private async Task RefreshDataAsync()
    {
        _courseThemes = await HttpClient.GetFromJsonAsync<List<DetailedCourseThemeDtos>>
            ($"{ApiEndpointRoutes.CourseThemes.AdminGetAll}");

        if (_courseThemes != null) _selectedCt = _courseThemes.FirstOrDefault(x => x.Id == _selectedCtId)?.Name;

        StateHasChanged();
    }

    private void HandleModuleItemSelected(Guid selectedId)
    {
        _selectedModulePreviewId = selectedId;
        _selectedVideoCoursePreviewId = Guid.Empty;
        StateHasChanged();
    }

    private void HandleVideoCourseItemSelected(Guid selectedId)
    {
        _selectedVideoCoursePreviewId = selectedId;
        StateHasChanged();
    }

}*@