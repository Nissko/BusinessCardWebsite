@*@using BusinessCardProject.Client.Pages.AdminPanelPages.Сomponents.CourseThemesComponent.Components.DynamicDialogs
@using BusinessCardProject.Client.Pages.AdminPanelPages.Сomponents.CourseThemesComponent.Components.DynamicDialogs.Params
@using ContractualDtos.DTO.Course.CourseTheme.Dtos
@inject IDialogService Dialog

@if (CourseTheme != null)
{
    foreach (var courseTheme in CourseTheme.Where(ctn => ctn.Name == SelectedCt))
    {
        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText>
                <b>Название</b>:
                <ul>@courseTheme.Name</ul>
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(courseTheme.Id,
                                        new DialogParameters<DialogCustomComponent>
                                        {
                                            { x => x.LabelTextString, "Название" },
                                            { x => x.NameOfApiKey, $"{nameof(courseTheme.Name)}" },
                                            { x => x.InputType, DynamicInputType.Text },
                                            { x => x.InputValueString, courseTheme.Name }
                                        },
                                        _backdropClick))"/>
        </MudItem>
        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText Class="mb-2"
                     Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <b>Описание</b>: @courseTheme.Description
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(courseTheme.Id,
                                        new DialogParameters<DialogCustomComponent>
                                        {
                                            { x => x.LabelTextString, "Описание" },
                                            { x => x.NameOfApiKey, $"{nameof(courseTheme.Description)}" },
                                            { x => x.InputType, DynamicInputType.TextArea },
                                            { x => x.InputValueString, courseTheme.Description }
                                        },
                                        _backdropClick))"/>
        </MudItem>
        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText>
                <b>Порядок отображения</b>:
                <ul>@courseTheme.DisplayOrder</ul>
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(courseTheme.Id, new DialogParameters<DialogCustomComponent>
                                        {
                                            { x => x.LabelTextString, "Порядок отображения" },
                                            { x => x.NameOfApiKey, $"{nameof(courseTheme.DisplayOrder)}" },
                                            { x => x.InputType, DynamicInputType.Number },
                                            { x => x.InputValueString, courseTheme.DisplayOrder.ToString() }
                                        },
                                        _backdropClick))"/>
        </MudItem>
        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText>
                <b>Показывать</b>:
                <ul>@(courseTheme.IsActive ? "Да" : "Нет")</ul>
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(courseTheme.Id, new DialogParameters<DialogCustomComponent>
                                        {
                                            { x => x.LabelTextString, "Показывать" },
                                            { x => x.NameOfApiKey, $"{nameof(courseTheme.IsActive)}" },
                                            { x => x.InputType, DynamicInputType.Boolean },
                                            { x => x.InputValueString, courseTheme.IsActive.ToString() }
                                        },
                                        _backdropClick))"/>
        </MudItem>
        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText>
                <b>Бесплатный</b>:
                <ul>@(courseTheme.IsFree ? "Да" : "Нет")</ul>
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(courseTheme.Id, new DialogParameters<DialogCustomComponent>
                                        {
                                            { x => x.LabelTextString, "Бесплатный" },
                                            { x => x.NameOfApiKey, $"{nameof(courseTheme.IsFree)}" },
                                            { x => x.InputType, DynamicInputType.Boolean },
                                            { x => x.InputValueString, courseTheme.IsFree.ToString() }
                                        },
                                        _backdropClick))"/>
        </MudItem>
        <MudItem Class="d-flex justify-space-between align-center">
            <MudText>
                <b>Рекомендации</b>:
                <ul>@string.Join(',', courseTheme.CourseThemeRecommendation.Select(ctr => ctr.Name))</ul>
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(courseTheme.Id, new DialogParameters<DialogCustomComponent>
                                        {
                                            { x => x.LabelTextString, "Рекомендации" },
                                            { x => x.NameOfApiKey, $"{nameof(courseTheme.CourseThemeRecommendation)}" },
                                            { x => x.InputType, DynamicInputType.Text },
                                            { x => x.InputValueString, string.Join(',', courseTheme.CourseThemeRecommendation.Select(ctr => ctr.Name)) }
                                        },
                                        _backdropClick))"/>
        </MudItem>
    }
}

@code {
    private readonly DialogOptions _backdropClick = new() { BackdropClick = false, FullWidth = true };

    [Parameter] public EventCallback OnDataChanged { get; set; }
    [Parameter] public IEnumerable<DetailedCourseThemeDtos>? CourseTheme { get; set; }
    [Parameter] public string? SelectedCt { get; set; }

    private async Task OpenDialogAsync(Guid id, DialogParameters<DialogCustomComponent> parameters, DialogOptions options)
    {
        const string typeName = "Редактирование";
        parameters.Add(x => x.ButtonTextString, "Изменить");
        parameters.Add(x => x.RecordId, id);
        parameters.Add(x => x.NameOfApi, TypeOfEntityType.CourseThemes);

        var dialogReference = await Dialog.ShowAsync<DialogCustomComponent>(typeName, parameters, options);
        var dialogResult = await dialogReference.Result;

        if (!dialogResult.Canceled)
        {
            if (OnDataChanged.HasDelegate)
            {
                await OnDataChanged.InvokeAsync();
            }
        }
    }

}*@