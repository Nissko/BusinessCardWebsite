<MudPaper Style="width: 50%" Class="mr-2 px-2 py-2 mtp-mx-vh-custom" Elevation="1">
    <div Class="d-flex justify-space-between align-center px-2">
        <MudText Typo="Typo.body1">
            Тема: @CourseTheme?.Name
        </MudText>

        @if (string.IsNullOrEmpty(CourseTheme?.Id) && !string.IsNullOrEmpty(SelectedPlId))
        {
            <MudIconButton Icon="@Icons.Material.Rounded.Add"
                           Size="Size.Small"
                           OnClick="AddNewCourseTheme"/>
        }
    </div>
    <MudDivider Class="my-2"/>

    <div class="px-2">
        <MudTreeView T="string"
                     Hover="true"
                     ExpandOnClick="true">
            @if (CourseTheme != null && !string.IsNullOrEmpty(CourseTheme?.Name))
            {
                if (CourseTheme != null && CourseModules != null)
                {
                    foreach (var module in CourseModules)
                    {
                        if (!Guid.TryParse(module.Id, out var moduleId)) continue;

                        <MudTreeViewItem Text="@module.Name"
                                         TextTypo="Typo.body1"
                                         Class="mb-1"
                                         Value="@module.Id"
                                         Expanded="@GetModuleExpandedState(moduleId)"
                                         ExpandedChanged="@((expanded) => OnModuleExpandedChanged(moduleId, expanded))">
                            @if (_moduleContentsCache.TryGetValue(moduleId, out var moduleVideos))
                            {
                                var index = 0;
                                foreach (var videoCourse in moduleVideos)
                                {
                                    if (!Guid.TryParse(videoCourse.Id, out var videoId)) continue;
                                    index++;

                                    <MudTreeViewItem Text="@($"Урок {index}. {videoCourse.Name}")"
                                                     TextTypo="Typo.body1"
                                                     Class="mt-1 mb-1"
                                                     Value="@videoCourse.Id"
                                                     Expanded="@GetVideoCourseExpandedState(videoId)"
                                                     ExpandedChanged="@((expanded) => OnVideoCourseExpandedChanged(videoId, expanded))">
                                        <MudGrid Class="pt-4 pb-4 pr-7">
                                            <MudItem xs="12" md="12">
                                                <MudImage Src="images/sweden.jpg"
                                                          Alt="Swedish Farm House"
                                                          Style="width: 100%"
                                                          Elevation="25"
                                                          Class="rounded-lg"/>
                                            </MudItem>
                                        </MudGrid>
                                    </MudTreeViewItem>
                                }
                            }
                        </MudTreeViewItem>
                    }
                }
                else if (CourseTheme != null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
                        Карточка пуста, необходимо ее настроить
                    </MudAlert>
                }
            }
        </MudTreeView>
    </div>
</MudPaper>