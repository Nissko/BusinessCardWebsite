@using ByteCodePlatform.Admin.Features.admin.dynamic_edit_dialog
@if (CourseModules != null && !string.IsNullOrEmpty(SelectedPreviewCourseModuleId.ToString()))
{
    var selectedModule = CourseModules.FirstOrDefault(cm => cm.Id == SelectedPreviewCourseModuleId.ToString());
    if (selectedModule != null && CourseModuleProperties != null)
    {
        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText>
                <b>Название</b>:
                <ul>@selectedModule.Name</ul>
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(
                                        Guid.Parse(selectedModule.Id),
                                        TypeOfEntityType.CourseModule,
                                        "Name",
                                        DynamicInputType.Text,
                                        selectedModule.Name,
                                        "Название"))"/>
        </MudItem>
        
        <MudItem Class="d-flex justify-space-between align-center">
            <MudText Class="mb-2"
                     Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <b>Свойства:</b>
            </MudText>
        </MudItem>
        
        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText Class="mb-2"
                Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <b>Порядок отображения</b>: 
                <ul>@CourseModuleProperties.DisplayOrder</ul>
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(
                                        Guid.Parse(selectedModule.Id),
                                        TypeOfEntityType.CourseModule,
                                        "DisplayOrder",
                                        DynamicInputType.Number,
                                        CourseModuleProperties.DisplayOrder.ToString(),
                                        "Порядок отображения"))"/>
        </MudItem>
        
        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText Class="mb-2"
                Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <b>Показывать</b>: 
                <ul>@(CourseModuleProperties.IsShow ? "Да" : "Нет")</ul>
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(
                                        Guid.Parse(selectedModule.Id),
                                        TypeOfEntityType.CourseModule,
                                        "IsShow",
                                        DynamicInputType.Boolean,
                                        CourseModuleProperties.IsShow.ToString(),
                                        "Показывать"))"/>
        </MudItem>
    }
}