@using ByteCodePlatform.Admin.Features.admin.dynamic_edit_dialog
@if (CourseTheme != null)
{
    var selectedTheme = CourseTheme.FirstOrDefault(ctn => ctn.Id == SelectedCtId.ToString());
    if (selectedTheme != null && SelectedCtProperties != null)
    {
        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText>
                <b>Название</b>:
                <ul>@selectedTheme.Name</ul>
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(
                                        Guid.Parse(selectedTheme.Id),
                                        TypeOfEntityType.CourseThemes,
                                        "Name",
                                        DynamicInputType.Text,
                                        selectedTheme.Name,
                                        "Название"))"/>
        </MudItem>

        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText Class="mb-2"
                     Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <b>Описание</b>: @selectedTheme.Description
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(
                                        Guid.Parse(selectedTheme.Id),
                                        TypeOfEntityType.CourseThemes,
                                        "Description",
                                        DynamicInputType.TextArea,
                                        selectedTheme.Description,
                                        "Описание"))"/>
        </MudItem>

        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText Class="mb-2"
                     Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <b>Обложка</b>:
                @selectedTheme.AvatarUrl
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(
                                        Guid.Parse(selectedTheme.Id),
                                        TypeOfEntityType.CourseThemes,
                                        "AvatarUrl",
                                        DynamicInputType.Image,
                                        selectedTheme.AvatarUrl,
                                        "Обложка"))"/>
        </MudItem>

        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText Class="mb-2"
                     Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <b>Цена</b>:
                @selectedTheme.Price
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(
                                        Guid.Parse(selectedTheme.Id),
                                        TypeOfEntityType.CourseThemes,
                                        "Price",
                                        DynamicInputType.Number,
                                        selectedTheme.Price.ToString(),
                                        "Цена"))"/>
        </MudItem>

        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText Class="mb-2"
                     Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <b>Старая цена</b>:
                @selectedTheme.OldPrice
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(
                                        Guid.Parse(selectedTheme.Id),
                                        TypeOfEntityType.CourseThemes,
                                        "OldPrice",
                                        DynamicInputType.Number,
                                        selectedTheme.OldPrice.ToString(),
                                        "Старая цена"))"/>
        </MudItem>

        /*TODO: Продумать и доработать по авторам*/
        @*<MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText Class="mb-2"
                     Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <b>Автор</b>: 
                
        

        @selectedTheme.Description
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(Guid.Parse(selectedTheme.Id),
                                        new DialogParameters<DynamicEditDialog>
                                        {
                                            { x => x.LabelTextString, "Описание" },
                                            { x => x.NameOfApiKey, nameof(selectedTheme.Description) },
                                            { x => x.InputType, DynamicInputType.TextArea },
                                            { x => x.InputValueString, selectedTheme.Description }
                                        },
                                        _backdropClick))"/>
        </MudItem>*@

        /*TODO: Продумать и доработать по ЯП (Возможно админ будет видеть все,
         а вот авторам будет даваться доступ на определенные темы)*/
        @*<MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText Class="mb-2"
                     Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <b>Язык программирования</b>: 
                
        

        @selectedTheme.Description
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(Guid.Parse(selectedTheme.Id),
                                        new DialogParameters<DynamicEditDialog>
                                        {
                                            { x => x.LabelTextString, "Описание" },
                                            { x => x.NameOfApiKey, nameof(selectedTheme.Description) },
                                            { x => x.InputType, DynamicInputType.TextArea },
                                            { x => x.InputValueString, selectedTheme.Description }
                                        },
                                        _backdropClick))"/>
        </MudItem>*@

        <MudItem Class="d-flex justify-space-between align-center">
            <MudText Class="mb-2"
                     Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <b>Свойства:</b>
            </MudText>
        </MudItem>

        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText>
                <b>Порядок отображения</b>:
                <ul>@SelectedCtProperties.DisplayOrder</ul>
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(
                                        Guid.Parse(selectedTheme.Id),
                                        TypeOfEntityType.CourseThemes,
                                        "DisplayOrder",
                                        DynamicInputType.Number,
                                        SelectedCtProperties.DisplayOrder.ToString(),
                                        "Порядок отображения"))"/>
        </MudItem>

        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText>
                <b>Показывать</b>:
                <ul>@(SelectedCtProperties.IsShow ? "Да" : "Нет")</ul>
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(
                                        Guid.Parse(selectedTheme.Id),
                                        TypeOfEntityType.CourseThemes,
                                        "IsShow",
                                        DynamicInputType.Boolean,
                                        SelectedCtProperties.IsShow.ToString(),
                                        "Показывать"))"/>
        </MudItem>

        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText>
                <b>Бесплатный</b>:
                <ul>@(selectedTheme.IsFree ? "Да" : "Нет")</ul>
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(
                                        Guid.Parse(selectedTheme.Id),
                                        TypeOfEntityType.CourseThemes,
                                        "IsFree",
                                        DynamicInputType.Boolean,
                                        SelectedCtProperties.IsFree.ToString(),
                                        "Бесплатный"))"/>
        </MudItem>
        
        <MudItem Class="mb-2 d-flex justify-space-between align-center">
            <MudText>
                <b>Скидка</b>:
                <ul>@(SelectedCtProperties.IsDiscount ? "Да" : "Нет")</ul>
            </MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                           OnClick="@(() => OpenDialogAsync(
                                        Guid.Parse(selectedTheme.Id),
                                        TypeOfEntityType.CourseThemes,
                                        "IsDiscount",
                                        DynamicInputType.Boolean,
                                        SelectedCtProperties.IsDiscount.ToString(),
                                        "Скидка"))"/>
        </MudItem>
    }
}