@*<MudContainer>
    <MudGrid>
        <MudItem Style="padding-left: 6px !important;" xs="12" md="12" Class="d-flex">
            <MudAutocomplete T="string" 
                             Label="Язык программирования" 
                             @bind-Value="_selectedPl"
                             SearchFunc="SearchFromPl"
                             ResetValueOnEmptyText="true"
                             AdornmentIcon="@Icons.Material.Rounded.Search" 
                             AdornmentColor="Color.Primary"
                             Class="px-1"/>

            <MudAutocomplete T="string" 
                             Label="Тема" 
                             @bind-Value="_selectedCt"
                             @bind-Value:after="UpdateSelectedCtId"
                             SearchFunc="SearchFromCt"
                             ResetValueOnEmptyText="true"
                             AdornmentIcon="@Icons.Material.Rounded.Search" 
                             AdornmentColor="Color.Primary"
                             Class="px-1"/>
        </MudItem>
        
        <MudItem Style="padding-left: 6px !important;" xs="12" md="12" Class="d-flex">
            <CourseTreePreview CourseTheme="_courseThemes" 
                               SelectedCt="@_selectedCt"
                               OnCourseModuleSelected="@HandleModuleItemSelected"
                               OnVideoCourseSelected="@HandleVideoCourseItemSelected"/>

            <MudTabs Outlined="true" 
                     Position="Position.Top" 
                     Rounded="true" 
                     Border="true"
                     ApplyEffectsToContainer="true" 
                     PanelClass="pa-6"
                     @bind-ActivePanelIndex="_activeIndex"
                     Style="width: 50%" 
                     Class="px-2 py-2"
                     Elevation="1">

                <MudTabPanel Text="Основная">
                    <CourseThemeEditor CourseTheme="_courseThemes"
                                       SelectedCt="@_selectedCt"
                                       OnDataChanged="RefreshDataAsync"/>
                </MudTabPanel>

                <MudTabPanel Text="Модули">
                    @if ((_selectedModulePreviewId == Guid.Empty || _selectedModulePreviewId == null) && 
                         !string.IsNullOrEmpty(_selectedCt))
                    {
                        <MudItem Class="d-flex align-center">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Add"/>
                            Добавить
                        </MudItem>
                    }

                    <CourseModuleEditor CourseModules="_courseThemes?.FirstOrDefault(cm => cm.Id == _selectedCtId)?.CourseModules.ToList()"
                                        SelectedPreviewCourseModuleId="_selectedModulePreviewId"
                                        OnDataChanged="RefreshDataAsync"/>
                </MudTabPanel>

                <MudTabPanel Text="Видео">
                    @if (_selectedModulePreviewId != Guid.Empty && _selectedModulePreviewId != null &&
                         (_selectedVideoCoursePreviewId == Guid.Empty || _selectedVideoCoursePreviewId == null) &&
                         !string.IsNullOrEmpty(_selectedCt))
                    {
                        <MudItem Class="d-flex align-center">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Add"/>
                            Добавить
                        </MudItem>
                    }

                    <CourseVideoEditor VideoCourses="_courseThemes?.FirstOrDefault(cm => cm.Id == _selectedCtId)?.CourseModules.FirstOrDefault(vc => vc.Id == _selectedModulePreviewId)?.VideoCourses.ToList()"
                                       SelectedPreviewCourseModuleId="_selectedVideoCoursePreviewId"
                                       OnDataChanged="RefreshDataAsync"/>
                </MudTabPanel>
            </MudTabs>
        </MudItem>
    </MudGrid>
</MudContainer>*@