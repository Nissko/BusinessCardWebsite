@using BusinessCardProject.Client.Features.toggle_theme

<MudNavMenu Class="mt-2">
    <MudNavLink Href="/home" 
                Match="NavLinkMatch.All"
                Icon="@Icons.Material.Rounded.Home">
        Главная
    </MudNavLink>
    
    <MudDivider Class="my-3" />
    
    <MudNavLink Href="/courses"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Rounded.MenuBook">
        Курсы
    </MudNavLink>
    
    @*TODO: Включить после доработки*@
    <MudTooltip Text="В разработке"
                Placement="Placement.Top">
        <MudNavLink Href="/project-news"
                    Disabled="true"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Rounded.Newspaper">
            Новости
        </MudNavLink>
    </MudTooltip>
    
    <MudNavLink Href="/donation-project"
                Match="NavLinkMatch.All"
                Icon="@Icons.Material.Rounded.VolunteerActivism">
        Поддержка проекта
    </MudNavLink>
    
    <MudDivider Class="my-4" />
    
    <div class="d-flex align-center justify-space-between px-4 mud-nav-item">
        <MudText Typo="Typo.body2" Class="d-flex align-center gap-2">
            Тема оформления
        </MudText>
        <ThemeToggle />
    </div>
</MudNavMenu>

