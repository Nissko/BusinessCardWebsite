@namespace BusinessCardProject.Client.Widgets.home.about_languages

<MudContainer MaxWidth="MaxWidth.Large"
              Class="py-8 px-4 text-center d-flex flex-column justify-center align-center">
    <MudText Typo="Typo.h4" Align="Align.Start" Class="mb-4" Style="font-weight: bold">
        Доступные языки
    </MudText>

    <MudTimeline TimelineOrientation="TimelineOrientation.Horizontal" 
                 TimelinePosition="TimelinePosition.Top" 
                 Class="mb-4">
        <MudTimelineItem Color="Color.Info" Variant="Variant.Outlined">
            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Class="mt-3">C#</MudChip>
        </MudTimelineItem>
        <MudTimelineItem Color="Color.Info" Variant="Variant.Outlined">
            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Class="mt-3">PHP</MudChip>
        </MudTimelineItem>
        <MudTimelineItem Color="Color.Info" Variant="Variant.Outlined">
            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Class="mt-3">Python</MudChip>
        </MudTimelineItem>
    </MudTimeline>
    
    <MudText Typo="Typo.body1" HtmlTag="p" Align="Align.Justify" Class="mb-8">
        Задайте основной язык в настройках. 
        Переключение между курсами доступно в любое время.
    </MudText>
</MudContainer>