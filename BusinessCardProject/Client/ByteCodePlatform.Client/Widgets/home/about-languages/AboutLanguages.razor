@namespace BusinessCardProject.Client.Widgets.home.about_languages

<MudContainer MaxWidth="MaxWidth.Medium" Class="text-center mt-8">
    <MudText Typo="Typo.h4" Class="mb-2" Align="Align.Center" Style="font-weight: 800; hyphens: auto;">
        Доступные языки программирования
    </MudText>
    <MudText Typo="Typo.body1" Class="mb-8" Style="color: #7f8c8d; max-width: 600px; margin: 0 auto;">
        Задайте основной язык в настройках платформы. Переключение между курсами доступно в любое время.
    </MudText>

    <MudGrid Justify="Justify.Center" Class="mb-6">
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2"
                      Class="pa-5 d-flex flex-column align-center justify-center hover-card transition-all"
                      Style="border-radius: 16px; border: 1px solid #e0e0e0; height: 100%;">
                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Large" Color="Color.Primary" Class="mb-3"/>
                <MudText Typo="Typo.h5" Style="font-weight: 700;">C#</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2"
                      Class="pa-5 d-flex flex-column align-center justify-center hover-card transition-all"
                      Style="border-radius: 16px; border: 1px solid #e0e0e0; height: 100%;">
                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Large" Color="Color.Secondary" Class="mb-3"/>
                <MudText Typo="Typo.h5" Style="font-weight: 700;">PHP</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2"
                      Class="pa-5 d-flex flex-column align-center justify-center hover-card transition-all"
                      Style="border-radius: 16px; border: 1px solid #e0e0e0; height: 100%;">
                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Large" Color="Color.Success" Class="mb-3"/>
                <MudText Typo="Typo.h5" Style="font-weight: 700;">Python</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>