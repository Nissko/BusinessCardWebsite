<MudTreeViewItem T="string" Text="@($"Урок {Index + 1}. {VideoCourse.Name}")"
                 TextTypo="Typo.h5" 
                 Class="mt-1 mb-1">
    <MudGrid Class="pt-4 pb-4 pr-7">
        <MudItem xs="12" md="3">
            <MudImage Src="images/sweden.jpg"
                      Alt="Swedish Farm House"
                      Style="width: 100%"
                      Elevation="25" 
                      ObjectFit="ObjectFit.Contain"
                      Class="rounded-lg"/>
        </MudItem>
        @*TODO: подумать, нужно ли описание*@
        @* <MudItem xs="12" md="9" Class="d-flex flex-column justify-start"> *@
        @*     <MudText Typo="Typo.body1" Class="pb-2"> *@
        @*         @VideoCourse.Description *@
        @*     </MudText> *@
        @* </MudItem> *@
        <MudItem xs="12" md="3" Class="pt-2 d-flex align-center">
            <MudButton Class="mt-2" 
                       Style="width: 100%;" 
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="@OnWatchClick">
                Смотреть
            </MudButton>
            
            @*TODO: Сделать изменение текста в зависимости от статуса авторизации пользователя*@
            <MudTooltip Text="Необходимо авторизоваться" 
                        Placement="Placement.Top">
                <MudIconButton Class="mt-2 ml-1"
                               Icon="@Icons.Material.Rounded.Favorite"
                               Color="Color.Secondary"
                               Disabled="true"
                               OnClick="@OnFavoriteClick"/>
            </MudTooltip>
        </MudItem>
    </MudGrid>
</MudTreeViewItem>