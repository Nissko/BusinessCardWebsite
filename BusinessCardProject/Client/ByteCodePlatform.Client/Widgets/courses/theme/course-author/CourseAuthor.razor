@namespace BusinessCardProject.Client.Widgets.courses.theme.course_author

<MudPaper Elevation="2" Class="author-card pa-4 pa-sm-5 text-center">
    <MudItem Class="d-flex flex-column" Style="align-items: center;">
        <MudAvatar Size="Size.Large" Color="Color.Primary" Class="rounded-circle"
                   Style="width: 96px; height: 96px; font-size: 2.5rem; 
                           box-shadow: 0 4px 12px rgba(0,0,0,.5);">
            @if (string.IsNullOrEmpty(Author.AvatarId))
            {
                <MudIcon Icon="@Icons.Material.Rounded.Person"/>
            }
            else
            {
                <img class="avatar-overlay-img"
                     Src="@GetLinksService.GetUrlFromImageService(Author.AvatarId)"
                     alt="Аватар"/>
            }
        </MudAvatar>

        <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@Author.Surname @Author.Name</MudText>
        <MudText Typo="Typo.caption" Style="color:#95a5a6;">Преподаватель курса</MudText>
    </MudItem>

    <MudDivider Style="margin-top: .75rem; border-bottom: 1px solid white;" Class="mb-3"/>

    @*TODO: доработать*@
    <MudText Typo="Typo.body2" Align="Align.Left" Style="line-height:1.6;">
        @Author.AboutUs
    </MudText>

    @*TODO: для доработки*@
    @*<div class="author-stats mt-3 mb-3">
        <div class="stat">
            <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:var(--mud-palette-primary);">15+</MudText>
            <MudText Typo="Typo.caption" Style="color:#95a5a6;">Курсов</MudText>
        </div>
        <div class="stat">
            <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:var(--mud-palette-primary);">500+</MudText>
            <MudText Typo="Typo.caption" Style="color:#95a5a6;">Студентов</MudText>
        </div>
        <div class="stat">
            <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:var(--mud-palette-primary);">4.9</MudText>
            <MudText Typo="Typo.caption" Style="color:#95a5a6;">Рейтинг</MudText>
        </div>
    </div>*@
</MudPaper>

<style>
    .author-card {
        border-radius: 16px;
        border: 1px solid #eee;
    }

    .author-stats {
        display: flex;
        justify-content: space-around;
    }

    .stat { text-align: center; }

    .avatar-overlay-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    
    @@media (min-width: 960px) {
        .author-card {
            position: sticky;
            top: 1.5rem;
        }
    }
</style>