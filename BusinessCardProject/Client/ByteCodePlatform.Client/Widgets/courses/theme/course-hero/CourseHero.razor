<MudItem xs="12">
    <MudImage ObjectFit="ObjectFit.Cover" 
              Src="@PreviewUrl"
              Alt="@Course.Name"
              Class="rounded-lg" 
              Height="256" 
              Style="width: 100%"/>
</MudItem>

<MudItem xs="12" md="9" Class="mt-4">
    <MudText Typo="Typo.h6" HtmlTag="p" Align="Align.Justify">
        @Course.Description
    </MudText>
</MudItem>