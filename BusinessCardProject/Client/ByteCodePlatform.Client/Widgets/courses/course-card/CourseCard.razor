<MudCard Elevation="1"
         Class="modern-card rounded-xl overflow-hidden course-card"
         Style="max-width: 380px; margin: auto; border-top: 4px solid var(--mud-palette-primary);">

    <MudCardContent Class="pb-2 course-card-content">
        <div class="course-card-body">

            <div class="course-card-top">
                <div class="d-flex justify-space-between align-start mb-3">
                    <MudText Typo="Typo.h5"
                             Style="font-weight: 700; letter-spacing: -0.5px; line-height: 1.3;">
                        @Course.Name
                    </MudText>

                    @if (Course.IsFree)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Variant="Variant.Filled"
                                 Size="Size.Small"
                                 Style="font-weight: 700; height: 28px; margin-top: 2px;">
                            Бесплатно
                        </MudChip>
                    }
                </div>
            </div>

            <div class="course-card-footer">

                @if (!Course.IsFree)
                {
                    <div class="course-price">
                        <MudIcon Icon="@Icons.Material.Rounded.LocalOffer"
                                 Size="Size.Small"
                                 Color="Color.Primary" />

                        <MudText Typo="Typo.h6" Style="font-weight: 700;">
                            @Course.Price
                        </MudText>

                        @if (CourseThemeProperties.FirstOrDefault(x => x.CourseThemeId == Course.Id)?.IsDiscount == true)
                        {
                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary"
                                     Style="text-decoration: line-through;">
                                @(Course.HasOldPrice ? Course.OldPrice : 0)
                            </MudText>
                        }
                    </div>
                }

                <MudButton OnClick="@(OnSelectClick)"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true"
                           Style="border-radius: 12px; text-transform: none; font-weight: 600; box-shadow: 0 4px 12px rgba(var(--mud-palette-primary-rgb), 0.3);">
                    @(Course.IsFree ? "Изучить бесплатно" : "Получить доступ")
                </MudButton>

            </div>

        </div>
    </MudCardContent>

</MudCard>

<style>
    .course-cards-grid .course-card-cell {
        display: flex;
    }
    
    .course-card {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    
    .course-card-content {
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    
    .course-card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    
    .course-card-top {
        margin-bottom: 16px;
    }
    
    .course-card-footer {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    
    .course-price {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 32px;
    }
</style>