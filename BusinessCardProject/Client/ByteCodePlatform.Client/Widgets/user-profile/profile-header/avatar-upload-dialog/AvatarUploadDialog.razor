<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Rounded.PhotoCamera" Class="mr-2" Size="Size.Small"/>
            Загрузка аватара
        </MudText>
    </TitleContent>

    <DialogContent>
        <div class="d-flex flex-column align-center pa-2">
            <MudAvatar Size="Size.Large" Class="mb-4"
                       Style="width: 128px; height: 128px; font-size: 3rem;
                              box-shadow: 0 4px 12px rgba(0,0,0,.3);">
                @if (!string.IsNullOrEmpty(PreviewBase64))
                {
                    <img src="@PreviewBase64" alt="Превью"
                         style="width:100%; height:100%; object-fit:cover; border-radius:50%;"/>
                }
                else if (!string.IsNullOrEmpty(CurrentAvatarUrl))
                {
                    <img src="@CurrentAvatarUrl" alt="Текущий аватар"
                         style="width:100%; height:100%; object-fit:cover; border-radius:50%;"/>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Rounded.Person"/>
                }
            </MudAvatar>

            <MudFileUpload T="IBrowserFile" Accept="image/png,image/jpeg,image/gif,image/webp"
                           FilesChanged="OnFileSelected">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Rounded.CloudUpload"
                               Style="border-radius: 8px; text-transform: none;">
                        Выбрать изображение
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>

            @if (SelectedFile is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-2">
                    @SelectedFile.Name (@FormatFileSize(SelectedFile.Size))
                </MudText>
            }

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2 d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Rounded.ErrorOutline" Size="Size.Small" Class="mr-1"/>
                    @ErrorMessage
                </MudText>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CloseDialog" Style="text-transform: none;">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="ConfirmDialog" Disabled="@(!CanSubmit)"
                   Style="border-radius: 8px; text-transform: none; font-weight: 600;">
            Загрузить
        </MudButton>
    </DialogActions>
</MudDialog>