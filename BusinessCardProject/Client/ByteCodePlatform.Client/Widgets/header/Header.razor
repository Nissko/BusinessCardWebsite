@using BusinessCardProject.Client.Features.auth_menu
@using BusinessCardProject.Client.Features.toggle_theme
@using BusinessCardProject.Client.Widgets.header.logos

<MudAppBar Elevation="0">
    @if (!_showHeaderButtons)
    {
        <MudIconButton Icon="@Icons.Material.Rounded.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer"/>
    }

    <MudLink Href="" Underline="Underline.None"
             Class="d-flex align-content-center justify-content-center">
        <MainLogo IsDark="UserSettingService.Settings.IsDark"/>
    </MudLink>

    @if (_showHeaderButtons)
    {
        /* Кнопки в верхнем меню, при широком экране */
        <MudButton Color="Color.Info" Href="/courses">
            Курсы
        </MudButton>

        /*TODO: Включить после доработки*/
        @*<MudTooltip Text="В разработке"
                    Placement="Placement.Bottom">
            <MudButton Disabled="true" Color="Color.Info" Href="/project-news">
                Новости
            </MudButton>
        </MudTooltip>*@

        <MudButton Color="Color.Info" Href="/donation-project">
            Поддержать
        </MudButton>
    }

    <MudSpacer/>

    @if (_showHeaderButtons)
    {
        <ThemeToggle/>
    }
    
    <UserMenu/>
</MudAppBar>