<MudItem Class="d-flex justify-space-between align-center px-2 py-2 h-100"
         Style="min-height: 74px;">
    <MudSwitch T="bool"
               Style="user-select: none;"
               Value="@_isCSharpSelected"
               ValueChanged="@(v => OnLanguageChanged(0, v))"
               LabelPlacement="@Placement"
               Color="Color.Success"
               UncheckedColor="Color.Error">
        <MudText Typo="Typo.caption">C#</MudText>
    </MudSwitch>

    <MudSwitch T="bool"
               Style="user-select: none;"
               Value="@_isPhpSelected"
               ValueChanged="@(v => OnLanguageChanged(1, v))"
               LabelPlacement="@Placement"
               Color="Color.Success"
               UncheckedColor="Color.Error">
        <MudText Typo="Typo.caption">PHP</MudText>
    </MudSwitch>

    <MudSwitch T="bool"
               Style="user-select: none;"
               Value="@_isLaravelSelected"
               ValueChanged="@(v => OnLanguageChanged(2, v))"
               LabelPlacement="@Placement"
               Color="Color.Success"
               UncheckedColor="Color.Error">
        <MudText Typo="Typo.caption">Laravel</MudText>
    </MudSwitch>
</MudItem>