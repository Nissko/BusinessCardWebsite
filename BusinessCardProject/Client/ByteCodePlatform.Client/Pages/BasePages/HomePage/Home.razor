    <div class="themes-container">
        <div class="theme-card p-3 mb-3 border rounded">
            <h5>@_checkGrpcCourseTimingResponse.DateTime</h5>
            <h5>@_checkGrpcCourseTimingResponse.GrpcService</h5>
            <h5>@_checkGrpcCourseTimingResponse.Health</h5>
        </div>
    </div>

    @*В будующем можно рассказать о достижениях*@
    @*В будующем можно рассказать о себе*@
</MudContainer>

@code
{
    private List<CourseThemeInfoResponse> ThemesInfoResponses = new();
    private CheckGrpcCourseTimingResponse _checkGrpcCourseTimingResponse = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            /*var request = new GetCourseThemesRequest();
            // Таймаут защитит от вечной загрузки при проблемах с сетью
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(60));
            
            var response = await Client.GetCourseThemesAsync(request, cancellationToken: cts.Token);
            ThemesInfoResponses = response.CourseThemes.ToList();
            Console.WriteLine(response);*/

            var secondRequest = new CheckGrpcCourseTimingRequest();
            using var secondCts = new CancellationTokenSource(TimeSpan.FromSeconds(60));
            
            var secondResponse = await Client.CheckGrpcCourseTimingAsync(secondRequest, cancellationToken: secondCts.Token);
            _checkGrpcCourseTimingResponse = secondResponse;
            Console.WriteLine(secondResponse);
        }
        catch (RpcException ex) when (ex.StatusCode == StatusCode.Unavailable)
        {
            errorMessage = "Сервис временно недоступен. Проверьте, запущен ли API-сервер.";
            Console.Error.WriteLine($"gRPC Unavailable: {ex.Status.Detail}");
        }
        catch (RpcException ex)
        {
            errorMessage = $"gRPC ошибка: {ex.Status.Detail}";
            Console.Error.WriteLine($"gRPC Error: {ex}");
        }
        catch (OperationCanceledException)
        {
            errorMessage = "Превышено время ожидания ответа от сервера.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Непредвиденная ошибка: {ex.Message}";
            Console.Error.WriteLine($"Unexpected Error: {ex}");
        }
        finally
        {
            isLoading = false;
            // StateHasChanged() не обязателен здесь, так как блейзор отслеживает асинхронные задачи,
            // но в сложных сценариях его можно вызвать явно.
        }
    }
}
