@page "/user-setting"
@using BusinessCardProject.Client.Widgets.setting.programmig_language_selector
@using BusinessCardProject.Client.Widgets.setting.video_platform_selector

<PageTitle>Настройки</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-6">

    <MudPaper Elevation="2" Class="rounded-xl pa-5 mb-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.Devices" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">
                Активные сессии
            </MudText>
        </MudStack>

        @if (_isLoadingSessions)
        {
            <MudProgressCircular Indent="@true" />
        }
        else if (_sessions.Any())
        {
            @foreach (var session in _sessions)
            {
                <MudItem Class="d-flex align-center mb-3">
                    <MudIcon Icon="@Icons.Material.Rounded.Laptop" Color="Color.Info" Class="mr-2" />
                    <MudText Typo="Typo.body2">
                        Создана: @session.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ml-2">
                        @session.ExpiresAt.ToString("dd.MM.yyyy HH:mm")
                    </MudChip>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Rounded.Close" Color="Color.Error" Size="Size.Small" OnClick="@(() => RevokeSession(session.TokenId))" />
                </MudItem>
            }

            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@LogoutAll">
                Выйти со всех устройств
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.body2">Нет активных сессий</MudText>
        }
    </MudPaper>
    
    <MudPaper Elevation="2" Class="rounded-xl pa-5 mb-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.PlayCircle" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">
                Платформа для просмотра
            </MudText>
        </MudStack>
        
        <MudText Typo="Typo.body2" Class="mb-4">
            Выберите предпочтительную видео-платформу для просмотра
        </MudText>

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="4">
                <VideoPlatformSelector />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="2" Class="rounded-xl pa-5 mb-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.Code" Color="Color.Secondary" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">
                Язык изучения
            </MudText>
        </MudStack>
        
        <MudText Typo="Typo.body2" Class="mb-4">
            Выберите язык программирования или предмет, который вы хотите изучать
        </MudText>

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="4">
                <ProgrammingLanguageSelector />
            </MudItem>
        </MudGrid>
    </MudPaper>

</MudContainer>