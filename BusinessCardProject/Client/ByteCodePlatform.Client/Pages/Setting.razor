@page "/user-setting"
@using BusinessCardProject.Client.Widgets.setting.video_platform_selector

<PageTitle>Настройки</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-6">
    <MudPaper Elevation="2" Class="rounded-xl pa-5 mb-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.PlayCircle" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">
                Платформа для просмотра
            </MudText>
        </MudStack>
        
        <MudText Typo="Typo.body2" Class="mb-4">
            Выберите предпочтительную видео-платформу для просмотра
        </MudText>

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="4">
                <VideoPlatformSelector />
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>