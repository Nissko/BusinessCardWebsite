@page "/reset-password/{UserId}/{ResetToken}"
@using BusinessCardProject.Client.App.layouts
@layout EmptyAuthLayout

<MudContainer MaxWidth="MaxWidth.Small">
    <MudText Typo="Typo.h5" Class="mb-4 text-center">Сброс пароля</MudText>

    @if (_success)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">Пароль успешно изменён.</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => NavManager.NavigateTo("/login"))">
            Войти
        </MudButton>
    }
    else
    {
        <MudTextField @bind-Value="_newPassword" Label="Новый пароль" Variant="Variant.Outlined" Margin="Margin.Dense"
                      InputType="InputType.Password" PasswordRevealIcon="@Icons.Material.Rounded.Visibility" />

        <MudTextField @bind-Value="_confirmPassword" Label="Подтвердите пароль" Variant="Variant.Outlined" Margin="Margin.Dense"
                      InputType="InputType.Password" PasswordRevealIcon="@Icons.Material.Rounded.Visibility" Class="mt-2" />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }

        @if (!string.IsNullOrEmpty(_passwordErrors))
        { 
            <MudAlert Severity="Severity.Warning" Class="mt-2">@_passwordErrors</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@HandleReset" Disabled="@_isLoading" Class="mt-3">
            Сбросить пароль
        </MudButton>
    }
</MudContainer>