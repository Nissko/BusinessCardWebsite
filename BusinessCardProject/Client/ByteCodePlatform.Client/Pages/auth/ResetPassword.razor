@page "/reset-password/{UserId}/{ResetToken}"
@layout EmptyAuthLayout
@using BusinessCardProject.Client.App.layouts

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8 py-sm-12 px-4">
    <MudCard Elevation="3" Class="rounded-xl overflow-hidden" 
             Style="border-top: 4px solid var(--mud-palette-primary); max-width: 520px; margin: auto;">
        
        <MudCardContent Class="pb-2">
            @if (_success)
            {
                <div class="d-flex flex-column align-center text-center py-4">
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled" Class="mb-3" Style="width: 64px; height: 64px;">
                        <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Size="Size.Large" />
                    </MudAvatar>
                    <MudText Typo="Typo.h5" Style="font-weight: 700; margin-bottom: 8px;">
                        Пароль успешно изменён
                    </MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4" Style="line-height: 1.6;">
                        Теперь вы можете войти в систему, используя новый пароль.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" 
                               OnClick="@(() => NavManager.NavigateTo("/login"))"
                               Class="rounded-lg" Style="text-transform: none; font-weight: 600; width: 100%;">
                        Войти в систему
                    </MudButton>
                </div>
            }
            else
            {
                <div class="d-flex flex-column align-center text-center mb-5">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Class="mb-3" Style="width: 56px; height: 56px;">
                        <MudIcon Icon="@Icons.Material.Rounded.VpnKey" Size="Size.Large" />
                    </MudAvatar>
                    <MudText Typo="Typo.h5" Style="font-weight: 700; letter-spacing: -0.5px;">
                        Новый пароль
                    </MudText>
                </div>

                <MudForm Model="@_model" @ref="_form" Validation="@_validator.ValidateValue" ValidationDelay="300">
                    <MudGrid Spacing="3">
                        <MudItem xs="12">
                            <MudTextField Value="_model.NewPassword"
                                          ValueChanged="@(async (string val) => await OnNewPasswordChanged(val))"
                                          For="@(() => _model.NewPassword)"
                                          Immediate="true"
                                          Label="Новый пароль"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          InputType="@_passwordInputType"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@_passwordIcon"
                                          IconSize="Size.Medium"
                                          OnAdornmentClick="TogglePasswordVisibility" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Value="_model.ConfirmPassword"
                                          ValueChanged="@(async (string val) => await OnConfirmPasswordChanged(val))"
                                          For="@(() => _model.ConfirmPassword)"
                                          Immediate="true"
                                          Label="Подтвердите пароль"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          InputType="@_confirmPasswordInputType"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@_confirmPasswordIcon"
                                          IconSize="Size.Medium"
                                          OnAdornmentClick="ToggleConfirmPasswordVisibility" />
                        </MudItem>
                    </MudGrid>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-4 rounded-lg">
                            @_errorMessage
                        </MudAlert>
                    }
                </MudForm>
            }
        </MudCardContent>

        @if (!_success)
        {
            <MudCardActions Class="flex-column pa-4 pt-0" Style="gap: 12px;">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Size="Size.Large" 
                           OnClick="@HandleReset" 
                           Disabled="@_isLoading" 
                           Class="rounded-lg" 
                           Style="font-weight: 600; text-transform: none;">
                    Сбросить пароль
                </MudButton>
                
                <MudButton Variant="Variant.Text" 
                           Color="Color.Default" 
                           OnClick="@(() => NavManager.NavigateTo("/login"))" 
                           Class="rounded-lg"
                           Style="text-transform: none; font-size: 0.95rem;">
                    <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" Class="mr-1" />
                    Вернуться ко входу
                </MudButton>
            </MudCardActions>
        }
    </MudCard>
</MudContainer>