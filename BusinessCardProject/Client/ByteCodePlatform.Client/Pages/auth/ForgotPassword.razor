@page "/forgot-password"
@layout EmptyAuthLayout
@using BusinessCardProject.Client.App.layouts

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8 py-sm-12 px-4">
    <MudCard Elevation="3" Class="rounded-xl overflow-hidden" 
             Style="border-top: 4px solid var(--mud-palette-primary); max-width: 520px; margin: auto;">
        
        <MudCardContent Class="pb-2">
            @if (_success)
            {
                <div class="d-flex flex-column align-center text-center py-4">
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled" Class="mb-3" Style="width: 64px; height: 64px;">
                        <MudIcon Icon="@Icons.Material.Rounded.MarkEmailRead" Size="Size.Large" />
                    </MudAvatar>
                    <MudText Typo="Typo.h5" Style="font-weight: 700; margin-bottom: 8px;">
                        Письмо отправлено
                    </MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4" Style="line-height: 1.6;">
                        Мы отправили ссылку для сброса пароля на указанный email. Проверьте папку "Входящие" или "Спам".
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" 
                               OnClick="@(() => NavManager.NavigateTo("/login"))"
                               Class="rounded-lg" Style="text-transform: none; font-weight: 600; width: 100%;">
                        Вернуться ко входу
                    </MudButton>
                </div>
            }
            else
            {
                <div class="d-flex flex-column align-center text-center mb-5">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Class="mb-3" Style="width: 56px; height: 56px;">
                        <MudIcon Icon="@Icons.Material.Rounded.LockReset" Size="Size.Large" />
                    </MudAvatar>
                    <MudText Typo="Typo.h5" Style="font-weight: 700; letter-spacing: -0.5px;">
                        Восстановление пароля
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        Введите email, указанный при регистрации, и мы отправим вам инструкцию
                    </MudText>
                </div>

                <MudTextField @bind-Value="_email"
                              Immediate="true"
                              Label="Электронная почта"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-4 rounded-lg">
                        <MudIcon Icon="@Icons.Material.Rounded.ErrorOutline" Class="mr-2" />
                        @_errorMessage
                    </MudAlert>
                }
            }
        </MudCardContent>

        @if (!_success)
        {
            <MudCardActions Class="flex-column pa-4 pt-0" Style="gap: 12px;">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Size="Size.Large" 
                           OnClick="@HandleSendReset" 
                           Disabled="@_isLoading" 
                           Loading="@_isLoading"
                           Class="rounded-lg" 
                           Style="font-weight: 600; text-transform: none;">
                    Отправить ссылку
                </MudButton>
                
                <MudButton Variant="Variant.Text" 
                           Color="Color.Default" 
                           OnClick="@(() => NavManager.NavigateTo("/login"))" 
                           Class="rounded-lg"
                           Style="text-transform: none; font-size: 0.95rem;">
                    <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" Class="mr-1" />
                    Вернуться ко входу
                </MudButton>
            </MudCardActions>
        }
    </MudCard>
</MudContainer>