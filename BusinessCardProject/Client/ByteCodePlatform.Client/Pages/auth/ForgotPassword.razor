@page "/forgot-password"
@layout EmptyAuthLayout
@using BusinessCardProject.Client.App.layouts

<MudContainer MaxWidth="MaxWidth.Small">
    <MudText Typo="Typo.h5" Class="mb-4 text-center">Восстановление пароля</MudText>

    @if (_success)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            <MudText>Письмо со ссылкой для сброса пароля отправлено на указанный email.</MudText>
        </MudAlert>
        <MudButton Variant="Variant.Text" OnClick="@(() => NavManager.NavigateTo("/login"))">
            Вернуться ко входу
        </MudButton>
    }
    else
    {
        <MudTextField @bind-Value="_email" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Icon="@Icons.Material.Rounded.Email" />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@HandleSendReset" Disabled="@_isLoading">
            Отправить ссылку
        </MudButton>
    }
</MudContainer>