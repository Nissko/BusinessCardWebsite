@page "/donation-project"
@using ZXing
@using MudExtensions

<PageTitle>Поддержать проект</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="my-6">
    <MudPaper Elevation="2" Class="rounded-xl pa-6 pa-md-8">
        <div class="d-flex flex-column align-center mb-6">
            <MudIcon Icon="@Icons.Material.Rounded.Favorite" Color="Color.Error" Size="Size.Large" Class="mb-2" />
            <MudText Typo="Typo.h5" Class="text-center font-weight-bold">
                Поддержать проект
            </MudText>
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="text-center">
                Ваш вклад помогает нам становиться лучше
            </MudText>
        </div>

        <MudGrid Spacing="4">
            <MudItem xs="12" md="5" Class="d-flex justify-center align-start">
                <MudPaper Elevation="0" Class="pa-4 rounded-lg d-flex flex-column align-center border-1 border-solid" Style="border-color: var(--mud-palette-divider);">
                    <MudBarcode Value="https://tips.tips/000463584" 
                                BarcodeFormat="BarcodeFormat.QR_CODE" 
                                Clickable="true"
                                Style="width: 180px; height: 180px; cursor: pointer;" />
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="7" Class="d-flex flex-column justify-center">
                <MudText Typo="Typo.body1" Align="Align.Left" Class="mb-4" Style="line-height: 1.6;">
                    Вы можете поддержать проект с помощью данных реквизитов, тем самым вложив средства в его 
                    дальнейшее развитие и улучшение. 
                </MudText>
                <MudText Typo="Typo.body1" Align="Align.Left" Class="mb-6" Style="line-height: 1.6;">
                    Ваша поддержка — это лучший сигнал, что то, что мы делаем, действительно ценно. 
                    Спасибо, что помогаете нам расти!
                </MudText>

                <MudButton Href="https://tips.tips/000463584"
                           Target="_blank"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Class="mt-auto"
                           Style="border-radius: 8px; text-transform: none; font-weight: 600;">
                    Поддержать проект
                </MudButton>
            </MudItem>
        </MudGrid>

    </MudPaper>
</MudContainer>

@code {
    // Дополнительная логика при необходимости
}