@page "/login"
@layout EmptyAuthLayout
@using BusinessCardProject.Client.Services.AuthUserService
@using FluentValidation
@using Severity = MudBlazor.Severity
@inject ClientAuthService AuthService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small">
    <MudCard Class="mx-auto rounded-xl h-100vh" MaxWidth="500px" Style="padding: 14px;">
        <MudCardContent>
            <MudText Typo="Typo.h5" Class="mb-4">Вход в систему</MudText>
        
            <MudForm Model="@_model" @ref="@_form" Validation="@_validator.ValidateValue" ValidationDelay="300">
            
                <MudTextField @bind-Value="_model.Email"
                              For="@(() => _model.Email)"
                              Immediate="true"
                              Label="Email"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Icon="@Icons.Material.Filled.Email"
                              @onkeydown="HandleEnter" />

                <MudTextField @bind-Value="_model.Password"
                              For="@(() => _model.Password)"
                              Immediate="true"
                              Label="Пароль"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Icon="@Icons.Material.Filled.Lock"
                              InputType="InputType.Password"
                              PasswordRevealIcon="Icons.Material.Filled.Visibility"
                              PasswordRevealIconActive="Icons.Material.Filled.VisibilityOff"
                              @onkeydown="HandleEnter" />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-4" @bind-Visible="_showError">
                        @_errorMessage
                    </MudAlert>
                }
            </MudForm>
        </MudCardContent>
    
        <MudCardActions Class="justify-space-between">
            <MudButton Variant="Variant.Text" OnClick="@(() => NavManager.NavigateTo("/register"))">
                Регистрация
            </MudButton>
            <MudItem>
                <MudButton Variant="Variant.Text" Size="Size.Small">
                    Забыли пароль?
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleLogin">
                    Войти
                </MudButton>
            </MudItem>
        </MudCardActions>
    </MudCard>
</MudContainer>


@code {
    private MudForm _form = null!;
    private readonly LoginModel _model = new();
    private readonly LoginModelFluentValidator _validator = new();
    
    private string _errorMessage = "";
    private bool _showError = false;
    private bool _isLoading = false;

    private async Task HandleLogin()
    {
        _showError = false;
        _errorMessage = "";
        
        await _form.Validate();
        
        if (!_form.IsValid)
        {
            Snackbar.Add("Проверьте правильность заполнения полей", Severity.Warning);
            return;
        }
        
        _isLoading = true;
        StateHasChanged();

        try
        {
            var success = await AuthService.Login(_model.Email, _model.Password);
            
            if (success)
            {
                Snackbar.Add("Успешный вход!", Severity.Success);
                NavManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                _errorMessage = "Неверный логин или пароль";
                _showError = true;
                Snackbar.Add(_errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка подключения: {ex.Message}";
            _showError = true;
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
    
    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isLoading)
        {
            await HandleLogin();
        }
    }

    public class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class LoginModelFluentValidator : AbstractValidator<LoginModel>
    {
        public LoginModelFluentValidator()
        {
            RuleFor(x => x.Email)
                .Cascade(CascadeMode.StopOnFirstFailure)
                .NotEmpty().WithMessage("Email обязателен")
                .EmailAddress().WithMessage("Некорректный формат Email");

            RuleFor(x => x.Password)
                .Cascade(CascadeMode.StopOnFirstFailure)
                .NotEmpty().WithMessage("Пароль обязателен")
                .MinimumLength(6).WithMessage("Минимум 6 символов");
        }

   
        public Func<object, string, Task<IEnumerable<string>>> ValidateValue => async (model, propertyName) =>
        {
            var context = new ValidationContext<LoginModel>((LoginModel)model);
            var result = await ValidateAsync(context);
            if (result.IsValid)
                return [];
    
            return result.Errors
                .Where(e => e.PropertyName == propertyName || string.IsNullOrEmpty(propertyName))
                .Select(e => e.ErrorMessage);
        };
    }
}