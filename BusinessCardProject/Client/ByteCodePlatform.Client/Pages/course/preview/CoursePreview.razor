@page "/course/{id:guid}"
@using BusinessCardProject.Client.Widgets.courses.theme.course_author
@using BusinessCardProject.Client.Widgets.courses.theme.course_content
@using BusinessCardProject.Client.Widgets.courses.theme.course_hero
@using CourseService.Proto
@inject CourseService.CourseServiceClient CourseGrpc

<PageTitle>
    @(CourseThemeInfo != null ? $"{CourseThemeInfo.Name}" : "Курс")
</PageTitle>

@if (CourseThemeInfo != null)
{
    <div class="course-page">
        <CourseHero Course="CourseThemeInfo"/>

        <MudContainer MaxWidth="MaxWidth.Large" Class="px-3 px-sm-4 py-6 py-md-8">
            <MudGrid Spacing="4">
                <MudItem xs="12" md="8">
                    <CourseContent Course="CourseThemeInfo" CourseGrpc="CourseGrpc"/>
                </MudItem>
                <MudItem xs="12" md="4">
                    <CourseAuthor Author="CourseThemeInfo.Author" />
                </MudItem>
            </MudGrid>
        </MudContainer>
    </div>
}

<style>
    .course-page {
        overflow-x: hidden;
    }
</style>