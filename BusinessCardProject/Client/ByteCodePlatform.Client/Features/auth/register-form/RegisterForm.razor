@using Severity = MudBlazor.Severity
@implements IDisposable

<MudCard Class="mx-auto rounded-xl"
         MaxWidth="500px"
         Style="padding: 14px;">
    <MudCardContent>
        <MudText Typo="Typo.h5" Class="mb-4">Регистрация</MudText>

        <MudForm Model="@_model" @ref="@_form"
                 Validation="@_validator.ValidateValue" ValidationDelay="300">

            <MudTextField @bind-Value="_model.Surname"
                          For="@(() => _model.Surname)"
                          Immediate="true"
                          Label="Фамилия"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          @onkeydown="HandleEnter"/>

            <MudTextField @bind-Value="_model.Name"
                          For="@(() => _model.Name)"
                          Immediate="true"
                          Label="Имя"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          @onkeydown="HandleEnter"/>

            <MudTextField @bind-Value="_model.NickName"
                          For="@(() => _model.NickName)"
                          Immediate="true"
                          Label="Никнейм"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          @onkeydown="HandleEnter"/>

            <MudTextField @bind-Value="_model.Email"
                          For="@(() => _model.Email)"
                          Immediate="true"
                          Label="Почта"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          @onkeydown="HandleEnter"/>

            <MudTextField @bind-Value="_model.Password"
                          For="@(() => _model.Password)"
                          Immediate="true"
                          Label="Пароль"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="InputType.Password"
                          @onkeydown="HandleEnter"/>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" @bind-Visible="_showError">
                    @_errorMessage
                </MudAlert>
            }
        </MudForm>
    </MudCardContent>

    <MudCardActions Class="justify-space-between">
        <MudButton Variant="Variant.Text" OnClick="@OnBackClick">
            Назад ко входу
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleRegister" Disabled="_isLoading">
            Зарегистрироваться
        </MudButton>
    </MudCardActions>
</MudCard>