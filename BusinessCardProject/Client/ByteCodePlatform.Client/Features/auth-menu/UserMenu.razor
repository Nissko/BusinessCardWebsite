<MudMenu Dense
         Variant="Variant.Text"
         Size="Size.Medium"
         Color="Color.Inherit"
         Icon="@Icons.Material.Rounded.MoreVert">

    <MudMenuItem Icon="@Icons.Material.Rounded.Settings"
                 IconColor="Color.Info"
                 Label="Настройки"
                 Href="/user-setting"
                 ForceLoad="false">
    </MudMenuItem>

    @if (IsAuthenticated)
    {
        <MudMenuItem Icon="@Icons.Material.Rounded.AdminPanelSettings"
                     IconColor="Color.Success"
                     Label="Админ-панель"
                     Href="/admin-panel"
                     ForceLoad="false">
        </MudMenuItem>
    }

    <MudDivider/>

    <MudMenuItem Icon="@Icons.Material.Rounded.Group"
                 IconColor="Color.Error"
                 Label="Пользовательское соглашение"
                 Href="/user-agreement"
                 ForceLoad="false"/>

    <MudMenuItem Icon="@Icons.Material.Rounded.SafetyDivider"
                 IconColor="Color.Error"
                 Label="Политика конфиденциальности"
                 Href="/privacy-policy"
                 ForceLoad="false"/>

    <MudDivider/>

    @if (!IsAuthenticated)
    {
        <MudMenuItem OnClick="@OnLoginClick"
                     ForceLoad
                     Icon="@Icons.Material.Rounded.Login"
                     IconColor="Color.Info"
                     Label="Вход"/>
    }
    else
    {
        <MudMenuItem OnClick="@OnLogoutClick"
                     ForceLoad
                     Icon="@Icons.Material.Rounded.Logout"
                     IconColor="Color.Info"
                     Label="Выход"/>
    }
</MudMenu>